# Config y restos del admin viejo no deben poder descargarse por URL.
<FilesMatch "^(config\.php|config\.example\.php|custom_prompt\.txt|login_attempts\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
